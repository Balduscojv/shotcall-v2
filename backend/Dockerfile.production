FROM php:8.4-fpm-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx supervisor gettext-base ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ADD --chmod=0755 https://github.com/mlocati/docker-php-extension-installer/releases/download/2.7.34/install-php-extensions /usr/local/bin/
RUN install-php-extensions pdo_pgsql pgsql intl gd zip bcmath pcntl redis opcache

# OPcache: o código não muda dentro da imagem, então não precisa conferir os arquivos a cada requisição.
RUN { \
      echo 'upload_max_filesize=16M'; \
      echo 'post_max_size=20M'; \
      echo 'memory_limit=256M'; \
    } > /usr/local/etc/php/conf.d/shotcall.ini \
    && { \
      echo 'opcache.enable=1'; \
      echo 'opcache.validate_timestamps=0'; \
      echo 'opcache.memory_consumption=96'; \
      echo 'opcache.interned_strings_buffer=16'; \
      echo 'opcache.max_accelerated_files=20000'; \
    } > /usr/local/etc/php/conf.d/zz-opcache.ini

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# A fila e o agendador rodam como www-data; com HOME=/root o libpq tenta ler
# /root/.postgresql/postgresql.crt e a conexão SSL com o Neon falha com "Permission denied".
ENV HOME=/var/www

WORKDIR /var/www/html

# Dependências antes do código: mudança só no código reaproveita esta camada no build. Na mesma
# camada (apagar depois não diminui a imagem): tira os serviços do SDK da AWS que não usamos (só o
# S3, para o R2; extra.aws/aws-sdk-php no composer.json) e o cache do Composer.
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --prefer-dist --no-progress --no-scripts --no-autoloader \
    && composer run-script pre-autoload-dump --no-interaction \
    && composer clear-cache --no-interaction

COPY . .

# Rotas, views e eventos não dependem do ambiente: cacheados aqui, e não a cada boot (a API dorme
# no Render Free e cada segundo do boot é espera de quem está entrando). A config depende das
# variáveis de ambiente e continua sendo cacheada no entrypoint.
RUN composer dump-autoload --no-dev --classmap-authoritative --no-interaction \
    && mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs storage/app/public bootstrap/cache \
    && APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= php artisan route:cache \
    && APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= php artisan view:cache \
    && APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= php artisan event:cache \
    && ln -sfn /var/www/html/storage/app/public /var/www/html/public/storage \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R ug+rwX storage bootstrap/cache

COPY docker/production/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY docker/production/php-fpm-pool.conf /usr/local/etc/php-fpm.d/zz-shotcall.conf
COPY docker/production/supervisord.conf /etc/supervisor/conf.d/shotcall.conf
COPY docker/production/entrypoint.sh /usr/local/bin/shotcall-production-entrypoint

RUN rm -f /etc/nginx/sites-enabled/default \
    && sed -i 's/\r$//' /usr/local/bin/shotcall-production-entrypoint \
    && chmod +x /usr/local/bin/shotcall-production-entrypoint

EXPOSE 10000

CMD ["/usr/local/bin/shotcall-production-entrypoint"]
